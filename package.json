{
  "author": "Richard Shephard",
  "bugs": { "url": "https://github.com/altrae/stencil-tailwind-plugin/issues" },
  "dependencies": {
    "chalk": "^4.1.2",
    "cssnano": "^7.1.9",
    "fs-extra": "^11.3.5",
    "p-queue": "^6.6.2",
    "postcss": "^8.5.15",
    "postcss-combine-duplicated-selectors": "10.0.3",
    "postcss-combine-media-query": "^1.0.1",
    "postcss-discard-comments": "^7.0.8",
    "postcss-load-config": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/types": "^29.6.3",
    "@stencil/core": "^4.43.5",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.0",
    "@types/postcss-import": "^14.0.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.62.0"
  },
  "name": "@altrae.dev/stencil-tailwind-plugin",
  "description": "This package is used to integrate [tailwindcss](https://tailwindcss.com/) and [StencilJS](https://stenciljs.com/). This plugin for Stencil is specifically focused on the integration between tailwindcss in [JIT](https://tailwindcss.com/docs/just-in-time-mode#enabling-jit-mode) mode and the Stencil build.",
  "files": ["dist/*"],
  "homepage": "https://github.com/altrae/stencil-tailwind-plugin#readme",
  "keywords": [
    "plugin",
    "stencil",
    "stenciljs",
    "tailwind",
    "tailwindcss"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "peerDependencies": {
    "@tailwindcss/postcss": ">=4.1.1",
    "tailwindcss": ">=4.1.1",
    "typescript": ">=5.8.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altrae/stencil-tailwind-plugin.git"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint --fix ./src eslint.config.mjs tsup.config.js jest.config.ts",
    "prepublishOnly": "pnpm build",
    "test": "jest --ci --runInBand",
    "test:update": "jest --runInBand --no-cache --updateSnapshot",
    "test:watch": "jest --runInBand --no-cache --watch"
  },
  "version": "2.0.5"
}
